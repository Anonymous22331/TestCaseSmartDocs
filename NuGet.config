<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="docsvision" value="https://nexus.docsvision.com/repository/nuget/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
    <packageSource key="docsvision"><package pattern="DocsVision.*" /></packageSource>
  </packageSourceMapping>
</configuration>
